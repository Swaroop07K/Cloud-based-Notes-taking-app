rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['title', 'body', 'tags', 'shared', 'shareExpiresAt', 'userId', 'createdAt', 'updatedAt'])
             && data.keys().size() == 8
             && data.title is string && data.title.size() <= 500
             && data.body is string && data.body.size() <= 100000
             && data.tags is list
             && data.shared is bool
             && (data.shareExpiresAt == null || data.shareExpiresAt is timestamp)
             && data.userId is string
             && data.createdAt is timestamp
             && data.updatedAt is timestamp;
    }

    match /users/{userId}/notes/{noteId} {
      // Owner can do everything
      allow list, create, delete: if isOwner(userId);
      
      // Update check
      allow update: if isOwner(userId)
        && isValidNote(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      // Special 'get' for public sharing
      allow get: if isOwner(userId) || (
        existing().shared == true &&
        (existing().shareExpiresAt == null || existing().shareExpiresAt > request.time)
      );
    }
  }
}
